{
  "organization": "CotEditor Project",
  "class-prefix": "",
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Debug-Sparkle",
    "Release",
    "Release-Sparkle",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
      "cs",
      "de",
      "en-GB",
      "es",
      "fr",
      "hi",
      "it",
      "ja",
      "ko",
      "nl",
      "pl",
      "pt",
      "ru",
      "tr",
      "uk",
      "zh-HK",
      "zh-Hans",
      "zh-Hant",
    ],
  },
  "packages": [
    {
      "kind": "remote",
      "repository": "https://github.com/1024jp/WFColorCode",
      "version": {
        "up-to-next-major-version": "4.0.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/sparkle-project/Sparkle",
      "version": {
        "up-to-next-major-version": "2.8.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/SimplyDanny/SwiftLintPlugins",
      "version": {
        "up-to-next-major-version": "0.62.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/apple/swift-numerics.git",
      "version": {
        "up-to-next-major-version": "1.1.0",
      },
    },
  ],
  "files": [
    { "path": "README.md" },
    { "path": "CHANGELOG.md" },
    { "path": "CONTRIBUTING.md" },
    { "kind": "folder", "path": "Configurations" },
    {
      "kind": "folder",
      "path": "CotEditor",
      "file-types": {
        "Resources/cot": "text.script.python",
      },
      "opaque-folders": [
        "Resources/Licenses",
        "Resources/Syntaxes",
        "Resources/Themes",
      ],
      "target-membership": [
        "CotEditor",
      ],
      "membership-exceptions": [
        {
          "target": "CotEditor",
          "exclusions": [
            "CotEditor.storekit",
            "Info.plist",
            "Resources/cot",
          ],
        }, {
          "build-phase": "CotEditor/copy/Copy Command-Line Tools",
          "inclusions": [
            "Resources/cot",
          ],
        },
      ],
    },
    { "kind": "folder", "path": "Tests", "target-membership": [ "Tests" ] },
    { "kind": "folder", "path": "UI Tests", "target-membership": [ "UI Tests" ] },
    { "kind": "folder", "path": "Test Plans" },
    { "kind": "folder", "path": "Scripts" },
    { "kind": "folder", "path": "Packages" },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/CotEditor.app", "id": "2A7380222CAD911F00E870E5", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/CotEditor.app", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/Tests.xctest", "id": "2A7380252CAD911F00E870E5", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/UI Tests.xctest", "id": "2A7380262CAD911F00E870E5", "type": "wrapper.cfbundle", "index": false },
      ],
    },
  ],
  "targets": [
    {
      "name": "CotEditor",
      "id": "2A6F0D4E1B5500E100C2D03C",
      "product": "id:2A7380222CAD911F00E870E5",
      "product-type": "application",
      "last-swift-migration": "9.0",
      "specialized-configurations": [
        { "name": "Debug", "file": { "anchor": "Configurations", "relative-path": "CotEditor.xcconfig" } },
        { "name": "Debug-Sparkle", "file": { "anchor": "Configurations", "relative-path": "CotEditor-Sparkle.xcconfig" } },
        { "name": "Release", "file": { "anchor": "Configurations", "relative-path": "CotEditor.xcconfig" } },
        { "name": "Release-Sparkle", "file": { "anchor": "Configurations", "relative-path": "CotEditor-Sparkle.xcconfig" } },
      ],
      "dependencies": [
        { "kind": "package", "product-name": "SyntaxMapBuilder" },
        { "kind": "package", "package": "SwiftLintPlugins", "product-name": "SwiftLintBuildToolPlugin", "product-type": "build-tool-plugin" },
      ],
      "build-phases": [
        {
          "kind": "script",
          "name": "Build Syntax Map",
          "log-environment-variables": true,
          "input-paths": [
            "$(SRCROOT)/CotEditor/Resources/Syntaxes",
          ],
          "output-paths": [
            "$(SRCROOT)/CotEditor/Resources/SyntaxMap.json",
          ],
          "shell": "/bin/sh",
          "script": "\"$BUILT_PRODUCTS_DIR/SyntaxMapBuilder\" \"$SCRIPT_INPUT_FILE_0\" \"$SCRIPT_OUTPUT_FILE_0\"\n",
        },
        "compile-sources",
        "resources",
        {
          "kind": "copy",
          "name": "Copy Command-Line Tools",
          "bundle-base-path": "shared-support-directory",
          "relative-path": "bin",
        },
        "frameworks",
        {
          "kind": "script",
          "name": "Remove Tree-sitter Bundles",
          "log-environment-variables": true,
          "scope": "install",
          "shell": "/bin/sh",
          "script": "\"$SRCROOT/Scripts/removeTreeSitterBundles.sh\"\n",
        },
      ],
      "package-product-members": [
        {
          "product-name": "EditorCore",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "MacUI",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "Syntax",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "Sparkle",
          "product-name": "Sparkle",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "WFColorCode",
          "product-name": "ColorCode",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "Accent Color",
        "CURRENT_PROJECT_VERSION": "853",
        "ENABLE_HARDENED_RUNTIME": "YES",
        "ENABLE_HARDWARE_CHECKED_POINTER_ARITHMETIC_SLICE": "NO",
        "ENABLE_POINTER_AUTHENTICATION": "NO",
        "ENABLE_USER_SCRIPT_SANDBOXING": "NO",
        "INFOPLIST_FILE": "CotEditor/Info.plist",
        "INFOPLIST_KEY_ITSAppUsesNonExemptEncryption": "NO",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.productivity",
        "INFOPLIST_KEY_NSAppleEventsUsageDescription": "${PRODUCT_NAME} needs your approval to control other applications with AppleScript.",
        "INFOPLIST_KEY_NSHumanReadableCopyright": "© 2005-2009 nakamuxu\n© 2011, 2014 usami-k\n© 2013-2026 1024jp",
        "INFOPLIST_KEY_NSMainStoryboardFile": "Main",
        "MARKETING_VERSION": "7.2.0-alpha",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.coteditor.CotEditor",
        "PRODUCT_NAME": "CotEditor",
        "SWIFT_STRICT_CONCURRENCY": "complete",
        "SWIFT_UPCOMING_FEATURE_CONCISE_MAGIC_FILE": "YES",
        "SWIFT_UPCOMING_FEATURE_DEPRECATE_APPLICATION_MAIN": "YES",
        "SWIFT_UPCOMING_FEATURE_FORWARD_TRAILING_CLOSURES": "YES",
        "SWIFT_UPCOMING_FEATURE_GLOBAL_CONCURRENCY": "YES",
        "SWIFT_UPCOMING_FEATURE_IMPLICIT_OPEN_EXISTENTIALS": "YES",
        "SWIFT_UPCOMING_FEATURE_IMPORT_OBJC_FORWARD_DECLS": "YES",
        "SWIFT_UPCOMING_FEATURE_INFER_SENDABLE_FROM_CAPTURES": "YES",
        "SWIFT_UPCOMING_FEATURE_ISOLATED_DEFAULT_VALUES": "YES",
        "SWIFT_UPCOMING_FEATURE_NONFROZEN_ENUM_EXHAUSTIVITY": "YES",
        "SWIFT_UPCOMING_FEATURE_REGION_BASED_ISOLATION": "YES",
        "SWIFT_VERSION": "5.0",
      },
    }, {
      "name": "Tests",
      "id": "2AC71DDE1BF0BDBC002E1434",
      "product": "Products/Tests.xctest",
      "product-type": "bundle.unit-test",
      "last-swift-migration": "9.0",
      "test-host-target": "CotEditor",
      "specialized-configurations": [
        { "name": "Debug", "file": { "anchor": "Configurations", "relative-path": "CodeSigning.xcconfig" } },
        { "name": "Debug-Sparkle", "file": { "anchor": "Configurations", "relative-path": "CodeSigning.xcconfig" } },
        { "name": "Release", "file": { "anchor": "Configurations", "relative-path": "CodeSigning.xcconfig" } },
        { "name": "Release-Sparkle", "file": { "anchor": "Configurations", "relative-path": "CodeSigning.xcconfig" } },
      ],
      "dependencies": [
        { "kind": "package", "package": "SwiftLintPlugins", "product-name": "SwiftLintBuildToolPlugin", "product-type": "build-tool-plugin" },
        "CotEditor",
      ],
      "build-phases": [
        "compile-sources",
        "resources",
        "frameworks",
      ],
      "package-product-members": [
        {
          "package": "swift-numerics",
          "product-name": "Numerics",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "BUNDLE_LOADER": "$(TEST_HOST)",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.coteditor.CotEditorTests",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "TEST_HOST": "$(BUILT_PRODUCTS_DIR)/CotEditor.app/$(BUNDLE_EXECUTABLE_FOLDER_PATH)/CotEditor",
      },
    }, {
      "name": "UI Tests",
      "id": "2A3F18F6203270BE002F1CA7",
      "product": "Products/UI Tests.xctest",
      "product-type": "bundle.ui-testing",
      "test-host-target": "CotEditor",
      "specialized-configurations": [
        { "name": "Debug", "file": { "anchor": "Configurations", "relative-path": "CodeSigning.xcconfig" } },
        { "name": "Debug-Sparkle", "file": { "anchor": "Configurations", "relative-path": "CodeSigning.xcconfig" } },
        { "name": "Release", "file": { "anchor": "Configurations", "relative-path": "CodeSigning.xcconfig" } },
        { "name": "Release-Sparkle", "file": { "anchor": "Configurations", "relative-path": "CodeSigning.xcconfig" } },
      ],
      "dependencies": [
        { "kind": "package", "package": "SwiftLintPlugins", "product-name": "SwiftLintBuildToolPlugin", "product-type": "build-tool-plugin" },
        "CotEditor",
      ],
      "build-phases": [
        "compile-sources",
      ],
      "build-settings": {
        "PRODUCT_BUNDLE_IDENTIFIER": "com.wolfrosch.CotEditorUITests",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "TEST_TARGET_NAME": "CotEditor",
      },
    }, {
      "name": "Update Help Index",
      "id": "2A3E847D1D07296200070A54",
      "kind": "aggregate",
      "build-phases": [
        {
          "kind": "script",
          "name": "Run Script",
          "log-environment-variables": true,
          "run-on-every-build": true,
          "shell": "/bin/sh",
          "script": [
            "cd Scripts",
            "./updateHelpindex.sh",
            "",
          ],
        },
      ],
      "build-settings": {
        "ENABLE_USER_SCRIPT_SANDBOXING": "NO",
        "PRODUCT_NAME": "Update Help Index",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
    "ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS": "YES",
    "CLANG_ANALYZER_LOCALIZABILITY_NONLOCALIZED": "YES",
