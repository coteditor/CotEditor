            "value" : "Your settings, one import away"
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your settings, one import away"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tus ajustes, a solo una importación"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Retrouvez vos réglages en une importation"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
