    "NewFeature.textKeyBinding.description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passe die Kurzbefehle zum Bewegen der Einfügemarke sowie zum Auswählen und Löschen von Text an, damit sich deine Finger ganz wie zu Hause fühlen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Customize shortcuts for moving the insertion point, selecting, and deleting text, so your fingers feel right at home."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Customise shortcuts for moving the insertion point, selecting, and deleting text, so your fingers feel right at home."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Personaliza los atajos para mover el punto de inserción, seleccionar y eliminar texto, y haz que tus dedos se sientan como en casa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Personnalisez les raccourcis pour déplacer le point d’insertion, sélectionner et supprimer du texte, et vos doigts se sentiront comme chez eux."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "挿入ポイントの移動やテキストの選択・削除に使うショートカットを、カスタマイズできるようになりました。いつもの指づかいで、もっと快適に。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "삽입점 이동, 텍스트 선택 및 삭제에 사용하는 단축키를 손에 익은 방식으로 사용자화할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pas de toetscombinaties aan voor het verplaatsen van het invoegpunt en het selecteren en verwijderen van tekst, zodat je vingers zich meteen thuis voelen."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Настройте сочетания клавиш для перемещения курсора, выделения и удаления текста, чтобы ваши пальцы чувствовали себя как дома."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Налаштуйте клавіатурні скорочення для переміщення точки вставлення, вибору й видалення тексту, щоб працювати було звично та зручно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自定移动插入点、选择和删除文本的快捷键，让手指操作得心应手。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可自訂移動插入點、選取與刪除文字的快速鍵，讓你怎麼按都順手。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自訂移動插入點、選擇與刪除文字的快捷鍵，令你打字得心應手。"
          }
        }
      }
    },
