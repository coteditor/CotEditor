    "NewFeature.copySettingsIniCloud.description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behalte eine stets aktuelle Kopie deiner Einstellungen in iCloud, um sie jederzeit auf deinen anderen Macs zu importieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Keep an up-to-date copy of your settings in iCloud to import on your other Macs anytime."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep an up-to-date copy of your settings in iCloud to import on your other Macs any time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Guarda en iCloud una copia siempre actualizada de tus ajustes para importarla en tus otros Mac cuando quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Conservez sur iCloud une copie toujours à jour de vos réglages, à importer à tout moment sur vos autres Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定のコピーを常に最新の状態でiCloudに保存して、ほかのMacでいつでも読み込めるようになりました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud에 최신 설정의 복사본을 유지하고, 언제든 다른 Mac에서 가져올 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bewaar een altijd actuele kopie van je instellingen in iCloud om ze op je andere Macs te importeren wanneer je maar wilt."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Храните актуальную копию настроек в iCloud для импорта на другие Mac в любое время."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зберігайте актуальну копію своїх параметрів в iCloud, щоб будь-коли імпортувати їх на інші свої компʼютери Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在iCloud中保留一份最新的设置副本，随时可导入到你的其他Mac。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在iCloud中保留最新的設定副本，隨時可在其他Mac上輸入。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在iCloud中儲存最新的設定副本，讓你隨時在其他Mac上輸入。"
          }
        }
      }
    },
