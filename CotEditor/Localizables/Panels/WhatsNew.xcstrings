          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Je instellingen, slechts één import verwijderd"
          }
        }
      }
    },
    "NewFeature.remoteEditing.description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne Dateien auf einem entfernten Computer mit `rmate` über SSH und sichere deine Änderungen direkt dort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Open files on a remote computer using `rmate` over SSH, and save your changes straight back."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open files on a remote computer using `rmate` over SSH, and save your changes straight back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Abre archivos de un ordenador remoto con `rmate` mediante SSH y guarda los cambios directamente en él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ouvrez des fichiers d’un ordinateur distant avec `rmate` via SSH et enregistrez-y directement vos modifications."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`rmate`を使ってSSH経由でリモートコンピュータ上のファイルを開き、変更内容をそのまま保存できるようになりました。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Open bestanden op een externe computer met `rmate` via SSH en bewaar je wijzigingen daar direct."
          }
        }
      }
    },
    "NewFeature.remoteEditing.label" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
