    "NewFeature.remoteEditing.description" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne Dateien auf einem entfernten Computer mit `rmate` über SSH und sichere deine Änderungen direkt dort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Open files on a remote computer using `rmate` over SSH, and save your changes straight back."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open files on a remote computer using `rmate` over SSH, and save your changes straight back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Abre archivos de un ordenador remoto con `rmate` mediante SSH y guarda los cambios directamente en él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ouvrez des fichiers d’un ordinateur distant avec `rmate` via SSH et enregistrez-y directement vos modifications."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "`rmate`を使ってSSH経由でリモートコンピュータ上のファイルを開き、変更内容をそのまま保存できるようになりました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH를 통해 `rmate`로 원격 컴퓨터의 파일을 열고, 변경 사항을 원격 컴퓨터에 바로 저장할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Open bestanden op een externe computer met `rmate` via SSH en bewaar je wijzigingen daar direct."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открывайте файлы на удаленном хосте с помощью `rmate` через SSH и сохраняйте изменения прямо там."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відкривайте файли на віддаленому компʼютері за допомогою `rmate` через SSH і зберігайте зміни безпосередньо на ньому."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过SSH使用`rmate`打开远程电脑上的文件，并将更改直接存回远程电脑。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "透過SSH使用`rmate`開啟遠端電腦上的檔案，並將變更直接存回遠端。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用`rmate`透過SSH開啟遙距電腦上的檔案，並直接將你的變更儲存回原處。"
          }
        }
      }
    },
