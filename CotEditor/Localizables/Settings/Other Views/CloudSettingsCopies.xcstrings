    "To stop saving a copy, turn off “Keep a copy in iCloud” on the Mac it comes from." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um keine Kopie mehr zu sichern, deaktiviere „Kopie in iCloud behalten“ auf dem Mac, von dem sie stammt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To stop saving a copy, turn off “Keep a copy in iCloud” on the Mac it comes from."
