    "To change a shortcut, click the key column, then type the new keys." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chcete-li změnit klávesovou zkratku, vyberte ji, klikněte na sloupec Zkratka a poté zadejte klávesovou zkratku."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Ändern eines Kurzbefehls klicke in die Taste-Spalte und drücke die neuen Tasten."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To change a shortcut, click the key column, then type the new keys."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para cambiar un atajo, haz clic en la columna Teclas y, a continuación, introduce la nueva combinación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour changer un raccourci, cliquez dans la colonne Raccourci, puis effectuez le raccourci désiré au clavier."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शॉर्टकट बदलने के लिए, कुंजी कॉलम पर क्लिक करें, फिर नई कुंजियाँ टाइप करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per modificare un’abbreviazione, fai clic sulla colonna dei tasti, poi digita la nuova combinazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ショートカットを変更するには、キー列をクリックして編集状態にしてから、新しいキーを入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단축키를 바꾸려면, 키 열을 클릭하고, 새 키를 입력하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je een toetscombinatie wilt wijzigen, klik je in de kolom 'Toets' en typ je de nieuwe toetsen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby zmienić skrót, kliknij kolumnę klawiszy, a następnie wprowadź nowe klawisze."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para alterar um atalho, clique na coluna Teclas e digite a nova combinação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы изменить сочетание клавиш, нажмите в столбце клавиш, затем введите новое сочетание."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir kestirmeyi değiştirmek için tuş sütununa tıklayın, ardından yeni tuşlara basın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб змінити скорочення, клацніть стовпець «Клавіша» і введіть нове сполучення клавіш."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过点击‘键’列，并输入新的键来修改快捷键。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如欲修改鍵盤熱鍵，請點一下熱鍵欄目，再敲下新的熱鍵。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如要更改快捷鍵，請按一下按鍵欄，然後輸入新的按鍵。"
          }
        }
      }
    }
  },
  "version" : "1.0"
