    "CommandLineToolManager.Status.differentTarget.message" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktuální symbolický odkaz `cot` neodkazuje na spuštěný CotEditor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der aktuelle symbolische Link `cot` verweist nicht auf die laufende Version von CotEditor."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The current `cot` symbolic link doesn’t target the running CotEditor."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The current `cot` symbolic link doesn’t target the running CotEditor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El enlace simbólico `cot` actual no se dirige al CotEditor en ejecución."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le lien symbolique `cot` actuel ne pointe pas vers la version de CotEditor en cours d’exécution."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मौजूदा `cot` सिंबॉलिक लिंक चल रहे CotEditor को लक्षित नहीं करता।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il link simbolico `cot` attuale non punta al CotEditor in esecuzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在の`cot`シンボリックリンクはこのCotEditor以外に向けられています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 `cot` 심볼릭 링크가 실행 중인 CotEditor를 가리키지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De huidige `cot` symbolische link richt zich niet op de actieve CotEditor."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obecne połączenie symboliczne `cot` nie wskazuje działającego CotEditora."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O link simbólico `cot` atual não aponta para o CotEditor em execução."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Текущая символическая ссылка `cot` не указывает на запущенный CotEditor."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geçerli `cot` sembolik bağı, çalışan CotEditor’ü hedeflemiyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поточне символічне посилання `cot` не вказує на запущений CotEditor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前的`cot`符号链接没有指向正在运行的CotEditor。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當前的`cot`符號鏈接沒有指向正在運行的CotEditor。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前`cot`符號連結的目標不是正在執行的CotEditor。"
          }
        }
      }
    },
