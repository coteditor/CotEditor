{
  "attributes" : [
    {
      "begin" : "(?<!\\S)(?<=\\s)[[:alnum:]\\p{M}_\\-.:\\u00B7\\u0387\\u203F\\u2040]+(?=\\s*=)",
      "regularExpression" : true
    }
  ],
  "characters" : [
    {
      "begin" : "%[^&%\"]+;(?=[^<>]*[\\[>])",
      "regularExpression" : true
    },
    {
      "begin" : "&[^\\s&<>;]++;",
      "regularExpression" : true
    },
    {
      "begin" : "<![CDATA[",
      "end" : "]]>",
      "isMultiline" : true
    }
  ],
  "commands" : [
    {
      "begin" : "(?<=<)\\?[[:alnum:]\\p{M}_\\-.:\\u00B7\\u0387\\u203F\\u2040]+",
      "regularExpression" : true
    },
    {
      "begin" : "\\?(?=>)",
      "regularExpression" : true
    }
  ],
  "keywords" : [
    {
      "begin" : "(?<![^</])(?<=</?)[[:alnum:]\\p{M}_\\-.:\\u00B7\\u0387\\u203F\\u2040]+(?=[\\r\\n\\t />])",
      "regularExpression" : true
    },
    {
      "begin" : "(?<=[\\r\\n\\t (|,])[[:alnum:]\\p{M}_\\-.:%\\u00B7\\u0387\\u203F\\u2040]+(?=[\\r\\n\\t )|,]?[^<>\\[]*[>\\[])",
      "regularExpression" : true
    }
  ],
  "strings" : [
    {
      "begin" : "(?<!\\w)'[^'\\-]*+(?:-(?!->)[^'\\-]*+)*+'(?=[^<>]*>)",
      "regularExpression" : true
    },
    {
      "begin" : "(?<=NDATA)\\s+[[:alnum:]\\p{M}_\\-.\\u00B7\\u0387\\u203F\\u2040]+(?=\\s*>)",
      "regularExpression" : true
    }
  ],
  "types" : [
    {
      "begin" : "(?<=<)![A-Z]*",
      "regularExpression" : true
    }
  ],
  "values" : [
    {
      "begin" : "(?<=[(|])#PCDATA(?=\\b)",
      "regularExpression" : true
    },
    {
      "begin" : "(?<=\\[)\\s*(?:IGNORE|INCLUDE)\\s*(?=\\[)",
      "regularExpression" : true
    },
    {
      "begin" : "(?<=\\s)#(?:FIXED|IMPLIED|REQUIRED)(?=[^<>]*>)",
      "regularExpression" : true
    },
    {
      "begin" : "(?<=\\s)(?:ANY|EMPTY)(?=[^<>]*>)",
      "regularExpression" : true
    },
    {
      "begin" : "(?<=\\s)(?:PUBLIC|SYSTEM)(?=\\s+[\"'])",
      "regularExpression" : true
    },
    {
      "begin" : "(?<=\\s)(?:SDATA|RCDATA|NAME|NUMBER|#CONREF|#SUBDOC)(?=[^<>]*>)",
      "description" : "for SGML DTD",
      "regularExpression" : true
    },
    {
      "begin" : "(?<=\\s)CDATA(?=[^<>]*>)",
      "regularExpression" : true
    },
    {
      "begin" : "(?<=\\s)ENTIT(?:Y|IES)(?=[^<>]*>)",
      "regularExpression" : true
    },
    {
      "begin" : "(?<=\\s)ID(?=[^<>]*>)",
      "regularExpression" : true
    },
    {
      "begin" : "(?<=\\s)IDREFS?(?=[^<>]*>)",
      "regularExpression" : true
    },
    {
      "begin" : "(?<=\\s)NDATA(?=[^<>]*>)",
      "regularExpression" : true
    },
    {
      "begin" : "(?<=\\s)NMTOKENS?(?=[^<>]*>)",
      "regularExpression" : true
    },
    {
      "begin" : "(?<=\\s)NOTATION(?=[^<>]*>)",
      "regularExpression" : true
    }
  ],
  "variables" : [
    {
      "begin" : "(?<![^</])(?<=</?)[[:alnum:]\\p{M}_\\-.\\u00B7\\u0387\\u203F\\u2040]+:(?=\\w)",
      "regularExpression" : true
    },
    {
      "begin" : "(?<!\\S)(?<=\\s)[[:alnum:]\\p{M}_\\-.\\u00B7\\u0387\\u203F\\u2040]+:(?=(\\w|[\\-.])+\\s*=)",
      "regularExpression" : true
    },
    {
      "begin" : "(?<!ATTLIST)\\s+[O\\-]\\s+[O\\-](?=\\s[^<>]*>)",
      "description" : "for SGML DTD",
      "regularExpression" : true
    },
    {
      "begin" : "(?<=\\b)[[:alnum:]\\p{M}_\\-.\\u00B7\\u0387\\u203F\\u2040]+:(?=\\w[^<>]*>)",
      "regularExpression" : true
    }
  ]
}